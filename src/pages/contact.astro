---
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/content';
const site = await getSite();
---
<!-- Email, location and links are in the footer below, so the page itself is just the intro -->
<Base title="Contact">
  <section class="grid head">
    <p class="label c-full">Contact</p>
    <h1 class="h1 c-3">Let's talk. <span class="mute">{site.availability}</span></h1>
  </section>
</Base>
<style>
  .head { padding-top: clamp(8rem, 16vw, 12rem); }
</style>
