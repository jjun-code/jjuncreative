---
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/content';
const site = await getSite();
---
<Base title="Contact">
  <section class="grid head">
    <p class="label c-full">Contact</p>
    <h1 class="h1 c-3">Let's talk. <span class="mute">{site.availability}</span></h1>
    <ul class="details c-full sub">
      <li><span class="label">Email</span><a href={`mailto:${site.email}`} class="sweep">{site.email}</a></li>
      <li><span class="label">Based in</span><span>{site.location}</span></li>
      <li><span class="label">Elsewhere</span><span class="links">{site.socials.map((s: any) => <a href={s.url} target="_blank" rel="noopener" class="sweep">{s.label}</a>)}</span></li>
    </ul>
  </section>
</Base>
<style>
  .head { padding-top: clamp(8rem, 16vw, 12rem); }
  /* One detail per column, each under a rule that starts at its grid line */
  .details { list-style: none; margin: clamp(2.5rem, 5vw, 4rem) 0 0; row-gap: 1.5rem; }
  .details li { display: grid; gap: 0.4rem; align-content: start; padding-top: 0.9rem; border-top: 1px solid var(--line); overflow-wrap: anywhere; }
  .details .label { margin: 0; }
  .links { display: flex; gap: 1rem; flex-wrap: wrap; }
  @media (max-width: 760px) { .details li { grid-column: 1 / -1; } }
</style>
