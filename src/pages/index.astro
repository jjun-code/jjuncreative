---
import Base from '../layouts/Base.astro';
import ProjectTrack from '../components/ProjectTrack.astro';
import { getWork, getSite, getJournal } from '../lib/content';

const site = await getSite();
const work = await getWork();
const journal = await getJournal();
---
<Base footer={false}>
  <h1 class="visually-hidden">jjuncreative: {site.role}, {site.location}</h1>
  <ProjectTrack work={work} journal={journal} />
</Base>
