---
import Base from '../../layouts/Base.astro';
import WorkIndex from '../../components/WorkIndex.astro';
import { getWork } from '../../lib/content';
const work = await getWork();
---
<Base title="Work">
  <header class="wrap head">
    <p class="label">Work</p>
    <h1 class="h1">Every project. <span class="mute">Start to finish.</span></h1>
  </header>
  <WorkIndex work={work} heading={false} />
</Base>
<style>
  .head { padding-top: clamp(8rem, 16vw, 12rem); }
  h1 { max-width: 12ch; }
</style>
