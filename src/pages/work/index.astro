---
import Base from '../../layouts/Base.astro';
import WorkIndex from '../../components/WorkIndex.astro';
import { getWork } from '../../lib/content';
const work = await getWork();
---
<Base title="Work">
  <header class="wrap head">
    <p class="dot">work</p>
    <h1 class="display">everything on the ring</h1>
  </header>
  <WorkIndex work={work} heading={false} />
</Base>
<style>
  .head { padding-top: clamp(7rem, 14vw, 11rem); }
  h1 { font-size: var(--step-4); margin-top: 1rem; }
</style>
