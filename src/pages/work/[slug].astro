---
import Base from '../../layouts/Base.astro';
import { getWork, renderBody, src } from '../../lib/content';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((w, i) => ({
    params: { slug: w.slug },
    props: { w, i, total: work.length, next: work[(i + 1) % work.length] },
  }));
}

const { w, i, total, next } = Astro.props;
const html = await renderBody(w.body);
const cover = src(w.cover, 2400);
const feature = src(w.inlineImage, 2000);
const nextThumb = src(next.cover, 1200) || src(next.inlineImage, 1200) || src(next.gallery[0], 1200);
---
<Base title={w.title} description={w.summary} image={cover}>
  <!-- --tint is the project's charm colour, used as a soft glow -->
  <article class="case" style={`--tint:${w.charm.color}`}>
    <header class="wrap top">
      <div class="crumbs">
        <a href="/work" class="tag">← All work</a>
        <span class="num">{String(i + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}</span>
      </div>
      <h1 class="h1 title">{w.title}</h1>
      <div class="lede">
        <p class="summary h3">{w.summary}</p>
        <dl class="facts">
          <div class="card"><dt class="label">Year</dt><dd>{w.year}</dd></div>
          <div class="card"><dt class="label">Category</dt><dd>{w.category}</dd></div>
          <div class="card"><dt class="label">Tools</dt><dd>{w.tools.join(', ')}</dd></div>
        </dl>
      </div>
    </header>

    {cover && (
      <figure class="cover wrap"><div class="frame"><img src={cover} alt={`${w.title} cover`} /></div></figure>
    )}

    {(w.problem || w.solution) && (
      <section class="ps wrap">
        {w.problem && <div class="card" data-reveal><p class="label">01. Problem</p><p>{w.problem}</p></div>}
        {w.solution && <div class="card" data-reveal><p class="label">02. Solution</p><p>{w.solution}</p></div>}
      </section>
    )}

    {w.intro && <p class="intro wrap h2" data-reveal>{w.intro}</p>}

    {feature && <figure class="feature wrap"><div class="frame"><img src={feature} alt="" loading="lazy" /></div></figure>}

    {html && <div class="story wrap" set:html={html} />}

    {w.gallery.length > 0 && (
      <section class="gallery wrap" aria-label="Gallery">
        {w.gallery.map((g: any) => (
          <figure data-reveal>
            <div class="frame"><img src={src(g, 2000)} alt={g.caption || ''} loading="lazy" /></div>
            {g.caption && <figcaption>{g.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )}

    <section class="wrap">
      <a href={`/work/${next.slug}/`} class="next card" data-cursor="next">
        <div class="next-copy">
          <p class="label">Next project</p>
          <span class="h1">{next.title}</span>
          <span class="next-meta">{next.year}, {next.category}</span>
        </div>
        {nextThumb && <div class="next-img"><img src={nextThumb} alt="" loading="lazy" /></div>}
      </a>
    </section>
  </article>
</Base>

<script>
  import { gsap, reduced } from '../../scripts/smooth';
  if (!reduced()) {
    gsap.from('.title', { yPercent: 40, opacity: 0, duration: 1.1, ease: 'expo.out' });
    gsap.from('.facts > div', { y: 20, opacity: 0, duration: 0.9, ease: 'expo.out', stagger: 0.07, delay: 0.2 });
    gsap.fromTo('.cover .frame', { clipPath: 'inset(10% 6% 10% 6% round 28px)' }, {
      clipPath: 'inset(0% 0% 0% 0% round 28px)', ease: 'none',
      scrollTrigger: { trigger: '.cover', start: 'top 85%', end: 'top 15%', scrub: true },
    });
    gsap.utils.toArray<HTMLElement>('.feature img').forEach((img) => {
      gsap.fromTo(img, { yPercent: -6 }, { yPercent: 6, ease: 'none', scrollTrigger: { trigger: img.parentElement, scrub: true } });
    });
  }
</script>

<style>
  .case { position: relative; }
  .case::before {
    content: ''; position: absolute; inset: 0 0 auto; height: 90svh; z-index: -1; pointer-events: none;
    background: radial-gradient(60% 70% at 80% 0%, color-mix(in srgb, var(--tint) 45%, transparent), transparent 70%);
  }
  .top { padding-top: clamp(7rem, 13vw, 10rem); }
  .crumbs { display: flex; align-items: center; justify-content: space-between; }
  .crumbs .tag:hover { color: var(--ink); border-color: #ffffff40; }
  .title { font-size: clamp(3rem, 1.5rem + 8vw, 10rem); margin: 2rem 0 2.5rem; overflow-wrap: anywhere; }
  .lede { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3rem; align-items: start; }
  .summary { color: var(--mute); max-width: 24ch; margin: 0; }
  .facts { margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .facts .card { padding: 1rem 1.1rem; border-radius: 16px; }
  .facts .label { margin-bottom: 0.4rem; }
  .facts dd { margin: 0; }

  .frame { overflow: hidden; border-radius: var(--radius); background: var(--panel); border: 1px solid var(--line); }
  .frame img { width: 100%; }
  .cover { margin: clamp(3rem, 6vw, 5rem) 0 0; }
  .cover .frame { min-height: 30vh; }

  .ps { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; padding-block: clamp(3rem, 7vw, 6rem); }
  .ps .card { padding: clamp(1.4rem, 3vw, 2.2rem); }
  .ps p:last-child { margin: 0; color: #cfcfcf; }

  .intro { max-width: 26ch; margin: 0 0 clamp(4rem, 8vw, 7rem); }

  .feature { margin: 0 0 clamp(3rem, 7vw, 6rem); }
  .feature .frame { height: 80svh; }
  .feature img { width: 100%; height: 115%; object-fit: cover; }

  .story { max-width: 62rem; margin-inline: auto; columns: 2 22rem; column-gap: 3rem; padding-bottom: clamp(3rem, 6vw, 5rem); color: #cfcfcf; }
  .story :global(h2), .story :global(h3) { color: var(--ink); letter-spacing: -0.04em; margin: 1.5em 0 0.6em; }
  .story :global(p) { break-inside: avoid; }
  .story :global(a) { color: var(--accent); }
  .story :global(img) { border-radius: var(--radius); margin: 1rem 0; column-span: all; }

  .gallery { display: grid; gap: 0.75rem; padding-bottom: clamp(4rem, 8vw, 7rem); }
  .gallery figure { margin: 0; }
  .gallery figcaption { font-size: var(--step--1); color: var(--mute); padding: 0.7rem 0 0 0.4rem; }
  @media (min-width: 900px) {
    .gallery { grid-template-columns: 1fr 1fr; }
    .gallery figure:first-child { grid-column: 1 / -1; }
  }

  .next {
    display: grid; grid-template-columns: 1fr minmax(0, 0.9fr); gap: 2rem; align-items: center;
    padding: clamp(1.4rem, 3vw, 2.4rem); overflow: hidden;
    transition: border-color 0.4s, background-color 0.4s;
  }
  .next:hover { border-color: var(--accent); background: #231a16; }
  .next .h1 { display: block; overflow-wrap: anywhere; transition: color 0.4s; }
  .next:hover .h1 { color: var(--accent); }
  .next-meta { display: block; margin-top: 1rem; color: var(--mute); font-size: var(--step--1); }
  .next-img { border-radius: 16px; overflow: hidden; aspect-ratio: 16 / 10; }
  .next-img img { width: 100%; height: 100%; object-fit: cover; transition: scale 0.8s var(--ease); }
  .next:hover .next-img img { scale: 1.05; }

  @media (max-width: 760px) {
    .lede, .ps, .next { grid-template-columns: 1fr; }
    .facts { grid-template-columns: 1fr 1fr; }
  }
</style>
