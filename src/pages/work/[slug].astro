---
import Base from '../../layouts/Base.astro';
import { getWork, renderBody, src } from '../../lib/content';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((w, i) => ({
    params: { slug: w.slug },
    props: { w, i, total: work.length, next: work[(i + 1) % work.length] },
  }));
}

const { w, i, total, next } = Astro.props;
const html = await renderBody(w.body);
const cover = src(w.cover, 2400);
const feature = src(w.inlineImage, 2000);
const nextThumb = src(next.cover, 1200) || src(next.inlineImage, 1200) || src(next.gallery[0], 1200);
---
<Base title={w.title} description={w.summary} image={cover} footerCta={false}>
  <article class="case">
    <header class="grid top">
      <div class="crumbs c-full">
        <a href="/work" class="tag">← All work</a>
        <span class="num">{String(i + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}</span>
      </div>
      <h1 class="h1 title c-full">{w.title}</h1>
      <p class="summary h3 c-1">{w.summary}</p>
      <dl class="facts c-3 sub">
        <div><dt class="label">Year</dt><dd>{w.year}</dd></div>
        <div><dt class="label">Category</dt><dd>{w.category}</dd></div>
        <div><dt class="label">Tools</dt><dd>{w.tools.join(', ')}</dd></div>
      </dl>
    </header>

    {cover && (
      <figure class="cover grid"><div class="frame c-full"><img src={cover} alt={`${w.title} cover`} /></div></figure>
    )}

    {(w.problem || w.solution) && (
      <section class="ps grid">
        {w.problem && <div class="c-2" data-reveal><p class="label">01. Problem</p><p>{w.problem}</p></div>}
        {w.solution && <div class="c-2" data-reveal><p class="label">02. Solution</p><p>{w.solution}</p></div>}
      </section>
    )}

    {w.intro && <div class="grid"><p class="intro h2 c-last3" data-reveal>{w.intro}</p></div>}

    {feature && <figure class="feature grid"><div class="frame c-full"><img src={feature} alt="" loading="lazy" /></div></figure>}

    {html && <div class="grid"><div class="story c-last3" set:html={html} /></div>}

    {w.gallery.length > 0 && (
      <section class="gallery grid" aria-label="Gallery">
        {w.gallery.map((g: any, gi: number) => (
          <figure class={gi === 0 ? 'c-full' : 'c-2'} data-reveal>
            <div class="frame"><img src={src(g, 2000)} alt={g.caption || ''} loading="lazy" /></div>
            {g.caption && <figcaption>{g.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )}

    <section class="grid">
      <a href={`/work/${next.slug}/`} class="next card c-full" data-cursor="next">
        <div class="next-copy">
          <p class="label">Next project</p>
          <span class="h1">{next.title}</span>
          <span class="next-meta">{next.year}, {next.category}</span>
        </div>
        {nextThumb && <div class="next-img"><img src={nextThumb} alt="" loading="lazy" /></div>}
      </a>
    </section>
  </article>
</Base>

<script>
  import { gsap, reduced } from '../../scripts/smooth';
  import { onPage } from '../../scripts/page';
  onPage(() => {
    if (!reduced()) {
      gsap.from('.title', { yPercent: 40, opacity: 0, duration: 1.1, ease: 'expo.out' });
      gsap.from('.facts > div', { y: 20, opacity: 0, duration: 0.9, ease: 'expo.out', stagger: 0.07, delay: 0.2 });
      gsap.fromTo('.cover .frame', { clipPath: 'inset(10% 6% 10% 6% round 8px)' }, {
        clipPath: 'inset(0% 0% 0% 0% round 8px)', ease: 'none',
        scrollTrigger: { trigger: '.cover', start: 'top 85%', end: 'top 15%', scrub: true },
      });
      gsap.utils.toArray<HTMLElement>('.feature img').forEach((img) => {
        gsap.fromTo(img, { yPercent: -6 }, { yPercent: 6, ease: 'none', scrollTrigger: { trigger: img.parentElement, scrub: true } });
      });
    }
  });
</script>

<style>
  .case { position: relative; }
  .top { padding-top: clamp(7rem, 13vw, 10rem); row-gap: 0; }
  .crumbs { display: flex; align-items: center; justify-content: space-between; }
  .crumbs .tag:hover { color: var(--ink); border-color: var(--line-strong); }
  .title { font-size: var(--step-5); margin: 2rem 0 2.5rem; overflow-wrap: anywhere; }
  .summary { color: var(--mute); margin: 0; }
  /* Facts sit one per column, each under a rule that starts on its grid line */
  .facts { margin: 0; }
  .facts > div { border-top: 1px solid var(--line); padding-top: 0.8rem; }
  .facts .label { margin-bottom: 0.4rem; }
  .facts dd { margin: 0; }

  .frame { overflow: hidden; border-radius: var(--radius); background: var(--panel); border: 1px solid var(--line); padding: 0; }
  .frame img { width: 100%; }
  .cover { margin: clamp(3rem, 6vw, 5rem) 0 0; }
  .cover .frame { min-height: 30vh; }

  .ps { padding-block: clamp(3rem, 7vw, 6rem); row-gap: 2rem; }
  .ps > div { border-top: 1px solid var(--line); padding-top: 0.9rem; }
  .ps p:last-child { margin: 0; color: var(--body); max-width: 52ch; }

  .intro { margin: 0 0 clamp(4rem, 8vw, 7rem); }

  .feature { margin: 0 0 clamp(3rem, 7vw, 6rem); }
  .feature .frame { height: 80svh; }
  .feature img { height: 115%; object-fit: cover; }

  .story { columns: 2 20rem; column-gap: calc(2 * var(--pad)); padding-bottom: clamp(3rem, 6vw, 5rem); color: var(--body); }
  .story :global(h2), .story :global(h3) { color: var(--ink); letter-spacing: -0.04em; margin: 1.5em 0 0.6em; }
  .story :global(p) { break-inside: avoid; }
  .story :global(a) { color: var(--accent-text); }
  .story :global(img) { border-radius: var(--radius); margin: 1rem 0; column-span: all; }

  .gallery { row-gap: var(--gutter); padding-bottom: clamp(4rem, 8vw, 7rem); }
  .gallery figure { margin: 0; }
  .gallery figcaption { font-size: var(--step--1); color: var(--mute); padding-top: 0.7rem; }

  .next {
    display: grid; grid-template-columns: 1fr minmax(0, 0.9fr); gap: 2rem; align-items: center;
    padding: clamp(1.4rem, 3vw, 2.4rem); overflow: hidden;
    transition: border-color 0.4s, background-color 0.4s;
  }
  .next:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, var(--panel)); }
  .next .h1 { display: block; overflow-wrap: anywhere; transition: color 0.4s; }
  .next:hover .h1 { color: var(--accent-text); }
  .next-meta { display: block; margin-top: 1rem; color: var(--mute); font-size: var(--step--1); }
  .next-img { border-radius: 6px; overflow: hidden; aspect-ratio: 16 / 10; }
  .next-img img { width: 100%; height: 100%; object-fit: cover; transition: scale 0.8s var(--ease); }
  .next:hover .next-img img { scale: 1.05; }

  @media (max-width: 760px) {
    .summary { grid-column: 1 / -1; margin-bottom: 1.5rem; }
    .facts { grid-column: 1 / -1; row-gap: 1rem; }
    .facts > div:last-child { grid-column: 1 / -1; }
    .ps > div, .gallery figure { grid-column: 1 / -1; }
    .next { grid-template-columns: 1fr; }
  }
</style>
