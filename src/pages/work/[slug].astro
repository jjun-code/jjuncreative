---
import Base from '../../layouts/Base.astro';
import { getWork, renderBody, src, inkOn } from '../../lib/content';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((w, i) => ({
    params: { slug: w.slug },
    props: { w, next: work[(i + 1) % work.length] },
  }));
}

const { w, next } = Astro.props;
const html = await renderBody(w.body);
const cover = src(w.cover, 2400);
const feature = src(w.inlineImage, 2000);
---
<Base title={w.title} description={w.summary} image={cover}>
  <article class="case" style={`--accent:${w.charm.color}`}>
    <header class="wrap top">
      <a href="/work" class="back sweep">all work</a>
      <h1 class="display title">{w.title}</h1>
      <div class="lede">
        <p class="summary">{w.summary}</p>
        <dl class="facts">
          <div><dt class="dot">year</dt><dd>{w.year}</dd></div>
          <div><dt class="dot">category</dt><dd>{w.category}</dd></div>
          <div><dt class="dot">tools</dt><dd>{w.tools.join(', ')}</dd></div>
        </dl>
      </div>
    </header>

    {cover && (
      <figure class="cover wrap"><div class="frame"><img src={cover} alt={`${w.title} cover`} /></div></figure>
    )}

    <section class="ps wrap">
      {w.problem && <div><h2 class="dot">problem</h2><p>{w.problem}</p></div>}
      {w.solution && <div><h2 class="dot">solution</h2><p>{w.solution}</p></div>}
    </section>

    {w.intro && <p class="intro wrap display">{w.intro}</p>}

    {feature && <figure class="feature"><img src={feature} alt="" loading="lazy" /></figure>}

    {html && <div class="story wrap" set:html={html} />}

    {w.gallery.length > 0 && (
      <section class="gallery wrap" aria-label="Gallery">
        {w.gallery.map((g: any) => (
          <figure>
            <img src={src(g, 2000)} alt={g.caption || ''} loading="lazy" />
            {g.caption && <figcaption>{g.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )}

    <a href={`/work/${next.slug}/`} class="next" data-cursor="next" style={`--next:${next.charm.color};--next-ink:${inkOn(next.charm.color)}`}>
      <span class="dot wrap">next project</span>
      <span class="display wrap">{next.title}</span>
    </a>
  </article>
</Base>

<script>
  import { gsap, reduced } from '../../scripts/smooth';
  if (!reduced()) {
    gsap.from('.title', { yPercent: 40, opacity: 0, duration: 1.1, ease: 'expo.out' });
    gsap.fromTo('.cover .frame', { clipPath: 'inset(12% 8% 12% 8% round 10px)' }, {
      clipPath: 'inset(0% 0% 0% 0% round 6px)', ease: 'none',
      scrollTrigger: { trigger: '.cover', start: 'top 85%', end: 'top 15%', scrub: true },
    });
    gsap.utils.toArray<HTMLElement>('.feature img, .gallery img').forEach((img) => {
      gsap.fromTo(img, { yPercent: -6 }, { yPercent: 6, ease: 'none', scrollTrigger: { trigger: img.parentElement, scrub: true } });
    });
  }
</script>

<style>
  .top { padding-top: clamp(7rem, 14vw, 11rem); }
  .back { font-size: var(--step--1); color: var(--steel); }
  .title { font-size: var(--step-4); margin: 1.5rem 0 2.5rem; overflow-wrap: anywhere; }
  .title::after {
    content: ''; display: inline-block; width: 0.35em; height: 0.35em; margin-left: 0.25em;
    background: var(--accent); transform: rotate(45deg) translateY(-0.2em);
  }
  .lede { display: grid; grid-template-columns: 1.3fr 1fr; gap: 3rem; align-items: start; }
  .summary { font-size: var(--step-1); line-height: 1.4; }
  .facts { margin: 0; display: grid; gap: 1rem; }
  .facts div { display: grid; grid-template-columns: 7rem 1fr; border-top: 1px solid #1b1d2026; padding-top: 0.6rem; }
  .facts dd { margin: 0; }

  .cover { margin: clamp(3rem, 6vw, 5rem) 0 0; }
  .frame { overflow: hidden; border-radius: 6px; background: var(--dial-deep); min-height: 30vh; }
  .frame img { width: 100%; }

  .ps { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; padding-block: clamp(4rem, 8vw, 7rem); }
  .ps h2 { margin-bottom: 0.8rem; }

  .intro { font-size: var(--step-2); line-height: 1.35; max-width: 32ch; text-transform: none; letter-spacing: -0.01em; margin: 0 0 clamp(4rem, 8vw, 7rem); }

  .feature { margin: 0 0 clamp(4rem, 8vw, 7rem); height: 80svh; overflow: hidden; }
  .feature img { width: 100%; height: 115%; object-fit: cover; }

  .story { max-width: 62rem; margin-inline: auto; columns: 2 22rem; column-gap: 3rem; padding-bottom: clamp(3rem, 6vw, 5rem); }
  .story :global(p) { break-inside: avoid; }
  .story :global(img) { border-radius: 6px; margin: 1rem 0; column-span: all; }

  .gallery { display: grid; gap: var(--gutter); padding-bottom: clamp(4rem, 8vw, 7rem); }
  .gallery figure { margin: 0; overflow: hidden; border-radius: 6px; }
  .gallery img { width: 100%; }
  .gallery figcaption { font-size: var(--step--1); color: var(--steel); padding-top: 0.6rem; }
  @media (min-width: 900px) {
    .gallery { grid-template-columns: 1fr 1fr; }
    .gallery figure:first-child { grid-column: 1 / -1; }
  }

  .next { display: block; padding-block: clamp(4rem, 10vw, 8rem); border-top: 1px solid #1b1d2026; transition: background 0.5s var(--ease), color 0.5s; }
  .next .display { display: block; font-size: var(--step-4); overflow-wrap: anywhere; }
  .next:hover { background: var(--next); color: var(--next-ink); }
  .next:hover .dot { color: inherit; }

  @media (max-width: 760px) {
    .lede, .ps { grid-template-columns: 1fr; }
  }
</style>
