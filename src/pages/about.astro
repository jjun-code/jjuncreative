---
import Base from '../layouts/Base.astro';
import { reader, src } from '../lib/content';
const a = (await reader.singletons.about.read())!;
const portrait = src(a.portrait, 1200);
---
<Base title="About">
  <section class="wrap intro">
    <p class="dot">about</p>
    <h1 class="display">{a.headline}</h1>
  </section>

  <section class="wrap split">
    {portrait && <figure class="portrait"><img src={portrait} alt="Portrait of Junjie" /></figure>}
    <div>
      <p class="hello">{a.hello}</p>
      <dl class="stats">
        {a.stats.map((s) => <div><dt class="dot">{s.label}</dt><dd>{s.value}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="wrap curios" aria-labelledby="curios-title">
    <h2 id="curios-title" class="dot">things i collect</h2>
    <ul>
      {a.interests.map((i) => <li class="display">{i}</li>)}
    </ul>
  </section>

  <section class="wrap exp" aria-labelledby="exp-title">
    <h2 id="exp-title" class="dot">work experience</h2>
    <ol>
      {a.experience.map((e) => (
        <li>
          <span class="years">{e.years}</span>
          <span class="co display">{e.company}</span>
          <span class="role">{e.role}<br /><span>{e.note}</span></span>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap kit" aria-labelledby="kit-title">
    <h2 id="kit-title" class="dot">toolkit</h2>
    <ul>
      {a.toolkit.map((t) => <li><strong>{t.name}</strong><span>{t.use}</span></li>)}
    </ul>
  </section>
</Base>

<style>
  .intro { padding-top: clamp(7rem, 14vw, 11rem); }
  h1 { font-size: var(--step-3); max-width: 20ch; margin-top: 1rem; }
  section + section { margin-top: clamp(4rem, 9vw, 8rem); }
  .split { display: grid; grid-template-columns: minmax(0, 0.8fr) 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: end; }
  .portrait { margin: 0; border-radius: 6px; background: var(--dial-deep); overflow: hidden; aspect-ratio: 3 / 4; }
  .portrait img { width: 100%; height: 100%; object-fit: cover; }
  .hello { font-size: var(--step-2); line-height: 1.3; }
  .stats { margin: 2.5rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .stats div { border-top: 1px solid #1b1d2026; padding-top: 0.6rem; }
  .stats dd { margin: 0.2rem 0 0; }

  .curios ul { list-style: none; padding: 0; margin: 1.2rem 0 0; display: flex; flex-wrap: wrap; gap: 0.2rem 0; }
  .curios li { font-size: var(--step-2); transition: color 0.3s; }
  .curios li:not(:last-child)::after { content: '⬩'; color: var(--signal); margin: 0 0.5em; font-size: 0.6em; vertical-align: middle; }
  .curios li:hover { color: var(--signal); }

  .exp ol { list-style: none; padding: 0; margin: 1.2rem 0 0; }
  .exp li { display: grid; grid-template-columns: 9rem 1fr 1fr; gap: 1rem; padding: 1.4rem 0; border-top: 1px solid #1b1d2026; align-items: baseline; }
  .years, .role span { color: var(--steel); font-size: var(--step--1); }
  .co { font-size: var(--step-1); }

  .kit { padding-bottom: clamp(5rem, 10vw, 8rem); }
  .kit ul { list-style: none; padding: 0; margin: 1.2rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); gap: 1px; background: #1b1d2026; border: 1px solid #1b1d2026; }
  .kit li { background: var(--dial); padding: 1.2rem; display: grid; gap: 0.2rem; }
  .kit span { color: var(--steel); font-size: var(--step--1); }

  @media (max-width: 760px) {
    .split { grid-template-columns: 1fr; }
    .stats { grid-template-columns: 1fr; }
    .exp li { grid-template-columns: 1fr; gap: 0.3rem; }
  }
</style>
