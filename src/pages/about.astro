---
import Base from '../layouts/Base.astro';
import DotArt from '../components/DotArt.astro';
import { reader, src } from '../lib/content';
const a = (await reader.singletons.about.read())!;
const portrait = src(a.portrait, 1200);
// Split the headline after its first sentence or comma for the two-tone treatment
const m = a.headline.match(/^(.+?[.,])\s+(.+)$/);
const [lead, rest] = m ? [m[1], m[2]] : [a.headline, ''];
---
<Base title="About">
  <section class="grid intro">
    <p class="label c-full">About</p>
    <h1 class="h1 c-3">{lead} {rest && <span class="mute">{rest}</span>}</h1>
  </section>

  <section class="grid split">
    {portrait && <figure class="portrait c-2" data-reveal><div class="card"><img src={portrait} alt="Portrait of Junjie" /></div></figure>}
    <div class="hello c-2" data-reveal>
      <p class="h3">{a.hello}</p>
      <dl class="stats">
        {a.stats.map((s, i) => (
          <div>
            <dt class="label">{String(i + 1).padStart(2, '0')}. {s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="grid block" aria-labelledby="exp-title">
    <h2 id="exp-title" class="h2 c-full" data-reveal>Experience. <span class="mute">Where I've been.</span></h2>
    <ol class="exp c-full sub">
      {a.experience.map((e) => (
        <li class="c-full sub" data-reveal>
          <span class="years">{e.years}</span>
          <span class="co h3">{e.company}</span>
          <span class="role c-2">{e.role}<br /><span>{e.note}</span></span>
        </li>
      ))}
    </ol>
  </section>

  <section class="grid block" aria-labelledby="kit-title">
    <h2 id="kit-title" class="h2 c-full" data-reveal>Toolkit. <span class="mute">What I use every day.</span></h2>
    <ul class="kit c-full sub">
      {a.toolkit.map((t, i) => (
        <li data-reveal>
          <div class="tool card has-art">
            <div class="art"><DotArt variant={i} /></div>
            <strong>{t.name}</strong>
            <span>{t.use}</span>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="grid block" aria-labelledby="curios-title">
    <h2 id="curios-title" class="h2 c-full" data-reveal>Off the clock. <span class="mute">Things I collect.</span></h2>
    <ul class="curios c-3" data-reveal>
      {a.interests.map((i) => <li class="tag">{i}</li>)}
    </ul>
  </section>
</Base>

<style>
  .intro { padding-top: clamp(8rem, 16vw, 12rem); }
  .split { margin-top: clamp(3rem, 6vw, 5rem); align-items: end; }
  .portrait { margin: 0; }
  .portrait .card { overflow: hidden; aspect-ratio: 4 / 5; }
  .portrait img { width: 100%; height: 100%; object-fit: cover; }
  .hello { display: flex; flex-direction: column; justify-content: end; gap: 2.5rem; }
  .hello .h3 { max-width: 24ch; margin: 0; }
  .stats { margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .stats div { border-top: 1px solid var(--line); padding-top: 0.8rem; }
  .stats .label { margin-bottom: 0.3rem; }
  .stats dd { margin: 0; }

  .block { margin-top: clamp(4rem, 9vw, 8rem); }
  .block h2 { margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }

  /* Experience rows: one ruled line per job, columns locked to the grid */
  .exp { list-style: none; margin: 0; }
  .exp li { padding-block: 1.3rem; border-top: 1px solid var(--line); align-items: baseline; }
  .exp li:last-child { border-bottom: 1px solid var(--line); }
  .years, .role span { color: var(--mute); font-size: var(--step--1); }

  .kit { list-style: none; margin: 0; row-gap: 1rem; }
  .tool { padding: 1rem; display: grid; gap: 0.2rem; height: 100%; transition: border-color 0.35s; }
  .tool:hover { border-color: var(--line-strong); }
  .tool .art { background: var(--well); border: 1px solid var(--line); border-radius: 12px; padding: 0.7rem; margin-bottom: 0.8rem; }
  .tool span { color: var(--mute); font-size: var(--step--1); }

  .curios { list-style: none; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .curios .tag { font-size: var(--step-0); padding: 0.5rem 1.1rem; color: var(--ink); background: var(--panel); transition: background-color 0.3s, color 0.3s; }
  .curios .tag:hover { background: var(--accent); color: var(--accent-ink); border-color: transparent; }

  @media (max-width: 760px) {
    .split { row-gap: 2rem; }
    .portrait, .hello { grid-column: 1 / -1; }
    .stats { grid-template-columns: 1fr; }
    .exp .role { grid-column: 1 / -1; margin-top: 0.4rem; }
  }
</style>
