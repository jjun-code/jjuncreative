---
// Every project as a square image tile on a circular track that loops
// endlessly, over the site's animated pixel background. This is the whole
// home page (on phones, a straight row that loops the same way). Scrolling,
// swiping or the arrow keys roll the track: the next
// tile comes up from the bottom right, the current one sits in the middle,
// and the previous one rolls away to the top left.
// The current project's details sit in the bottom left.
import { src } from '../lib/content';
const { work } = Astro.props;
---
<section class="projects" id="work" aria-label="Projects" style={`--n:${work.length}`}>
  <div class="stage">
    <div class="details" aria-live="polite">
      {work.map((w: any, i: number) => (
        <dl class="sheet" data-i={i} hidden={i !== 0}>
          <dt class="visually-hidden">Project</dt>
          <dd class="name">{w.title}</dd>
          <dt class="mono">Category</dt><dd>{w.category}</dd>
          <dt class="mono">Year</dt><dd>{w.year}</dd>
          {w.tools.length > 0 && <><dt class="mono">Tools</dt><dd class="tools">{w.tools.map((t: string) => <span>{t}</span>)}</dd></>}
        </dl>
      ))}
      {work.map((w: any, i: number) => (
        <div class="caption" data-i={i} hidden={i !== 0}>
          <p class="mono">{w.summary}</p>
          <a href={`/work/${w.slug}/`} class="mono view">View project <span aria-hidden="true">→</span></a>
        </div>
      ))}
    </div>

    <ul class="track">
      {work.map((w: any, i: number) => {
        const art = src(w.cover, 1200) || src(w.inlineImage, 1200) || src(w.gallery[0], 1200);
        return (
          <li class="tile" data-i={i} style={`--tint:${w.charm.color}; --i:${i}`}>
            <a href={`/work/${w.slug}/`} data-cursor="view" aria-label={w.title}>
              {art && <img src={art} alt="" crossorigin="anonymous" loading={i < 2 ? 'eager' : 'lazy'} />}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script>
  import { gsap, reduced } from '../scripts/smooth';
  import { tick } from '../scripts/sound';
  import { attachDitherHover } from '../scripts/ditherHover';

  const sec = document.querySelector<HTMLElement>('.projects');
  if (sec) {
    const tiles = [...sec.querySelectorAll<HTMLElement>('.tile')];
    const sheets = [...sec.querySelectorAll<HTMLElement>('.sheet')];
    const captions = [...sec.querySelectorAll<HTMLElement>('.caption')];
    const n = tiles.length;
    let active = 0;
    const track = sec.querySelector<HTMLElement>('.track')!;
    // Entrance plays as the loader dissolves, or straight away on later pages
    const intro = () => {
      if (reduced()) return;
      gsap.timeline({ defaults: { ease: 'expo.out' } })
        .from(track, { opacity: 0, scale: 0.85, y: 80, rotate: -4, duration: 1.8 }, 0)
        .from(sec.querySelector('.details'), { y: 24, opacity: 0, duration: 1.2 }, 0.35);
    };
    if (document.documentElement.classList.contains('is-loading')) {
      window.addEventListener('loader:reveal', intro, { once: true });
    } else {
      gsap.delayedCall(0.15, intro);
    }

    // Tiles ride a wheel pivoted off-screen at the bottom left. By distance k
    // from the current position: k > 0 waits down the arc at the bottom right,
    // k < 0 has rolled on up toward the top left. Each tile turns with the wheel.
    // Signed distance from the current position, wrapped so the track loops:
    // with five tiles, k runs from -2.5 to 2.5 and a tile re-enters on the
    // far side once it has rolled out of view.
    const wrap = (k: number) => ((((k + n / 2) % n) + n) % n) - n / 2;

    // Phones get a straight horizontal row instead of the wheel; it loops
    // the same way, and neighbours sit smaller and fainter either side
    const phone = window.matchMedia('(max-width: 760px)');

    const setActive = (a: number) => {
      if (a === active) return;
      active = a;
      // Only the current tile keeps its hover effect
      hovers.forEach((h, i) => i !== a && h?.leave());
      tick();
      sheets.forEach((s, i) => (s.hidden = i !== a));
      captions.forEach((c, i) => (c.hidden = i !== a));
      if (!reduced()) gsap.from([sheets[a], captions[a]], { y: 14, opacity: 0, duration: 0.6, ease: 'expo.out' });
    };

    const placeRow = (p: number) => {
      const size = tiles[0]?.offsetWidth ?? 300;
      const gap = size * 0.82; // neighbours are scaled down, so they can sit closer
      tiles.forEach((d, i) => {
        const k = wrap(i - p), ak = Math.abs(k);
        const scale = 1 - Math.min(ak, 1) * 0.3;
        // Fully visible in the middle, faint at the sides, gone before the wrap point
        const fade = ak <= 1 ? 1 - ak * 0.7 : Math.max(0, 0.3 * (1.8 - ak) / 0.8);
        d.style.transform = `translate3d(${k * gap}px, 0, 0) scale(${scale})`;
        d.style.opacity = String(fade);
        d.style.zIndex = String(100 - Math.round(ak * 10));
        d.style.pointerEvents = ak < 0.5 ? 'auto' : 'none';
      });
    };

    const place = (p: number) => {
      if (phone.matches) placeRow(p);
      else {
        const W = window.innerWidth, H = window.innerHeight;
        const size = tiles[0]?.offsetWidth ?? 400;
        // Centre of the current tile, relative to the screen centre (see .tile top)
        const cx = 0, cy = -0.04 * H;
        const px = -0.45 * W, py = 0.95 * H;
        const R = Math.hypot(cx - px, cy - py);
        const a0 = Math.atan2(cy - py, cx - px);
        const step = (size * 1.15) / R;
        tiles.forEach((d, i) => {
          const k = wrap(i - p);
          const a = a0 + k * step;
          const x = px + Math.cos(a) * R - cx, y = py + Math.sin(a) * R - cy;
          // Tiles that have rolled past fade fast; waiting tiles fade in before
          // the wrap point, so the jump from one end to the other is never seen
          const fade = k < 0 ? Math.max(0, 1 + k * 0.8) : Math.max(0, 1 - Math.max(0, k - 1.3));
          const scale = 1 - Math.min(Math.abs(k), 2) * 0.12;
          d.style.transform =
            `translate3d(${x}px, ${y}px, 0) rotateZ(${(k * step * 180) / Math.PI}deg) rotateX(10deg) scale(${scale})`;
          d.style.opacity = String(fade);
          d.style.zIndex = String(100 - Math.round(Math.abs(k) * 10));
          d.style.pointerEvents = Math.abs(k) < 0.5 ? 'auto' : 'none';
        });
      }
      setActive(((Math.round(p) % n) + n) % n);
    };

    // Wheel, trackpad, touch and arrow keys move a target position; the track
    // eases toward it and, once input stops, settles on the nearest project.
    let p = 0, target = 0, settle = 0, dragging = false;
    const nudge = (d: number) => {
      target += d;
      clearTimeout(settle);
      settle = window.setTimeout(() => { if (!dragging) target = Math.round(target); }, 140);
    };
    const go = (d: number) => { clearTimeout(settle); target = Math.round(target) + d; };

    sec.addEventListener('wheel', (e) => {
      e.preventDefault();
      const d = Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
      const px = e.deltaMode === 1 ? d * 40 : d;
      nudge(Math.max(-0.5, Math.min(0.5, px / 700)));
    }, { passive: false });

    // Touch: on phones the row follows the finger sideways, and a quick flick
    // moves on one project; elsewhere any swipe direction rolls the wheel
    let touchY = 0, touchX = 0, vx = 0, lastT = 0, startIndex = 0;
    sec.addEventListener('touchstart', (e) => {
      touchY = e.touches[0].clientY; touchX = e.touches[0].clientX;
      dragging = true; vx = 0; lastT = performance.now(); startIndex = Math.round(target);
    }, { passive: true });
    sec.addEventListener('touchmove', (e) => {
      const t = e.touches[0];
      const dy = touchY - t.clientY, dx = touchX - t.clientX;
      const now = performance.now();
      touchY = t.clientY; touchX = t.clientX;
      if (phone.matches) {
        const gap = (tiles[0]?.offsetWidth ?? 300) * 0.82;
        vx = dx / Math.max(1, now - lastT);
        target += dx / gap;
      } else {
        nudge((Math.abs(dy) > Math.abs(dx) ? dy : dx) / 260);
      }
      lastT = now;
    }, { passive: true });
    sec.addEventListener('touchend', () => {
      dragging = false;
      if (!phone.matches) return;
      // Settle on the nearest project; a quick flick that didn't drag far
      // enough to change project still moves one in that direction
      const landed = Math.round(target);
      const flick = Math.abs(vx) > 0.35 ? Math.sign(vx) : 0;
      target = landed === startIndex && flick ? startIndex + flick : landed;
    });

    window.addEventListener('keydown', (e) => {
      const el = e.target instanceof Element ? e.target : null;
      if (el?.closest('input, textarea, [contenteditable]')) return;
      if (['ArrowDown', 'ArrowRight', 'PageDown'].includes(e.key)) { e.preventDefault(); go(1); }
      if (['ArrowUp', 'ArrowLeft', 'PageUp'].includes(e.key)) { e.preventDefault(); go(-1); }
    });

    // Pixel dither sweep over the current tile's image on hover
    const hovers = tiles.map((t) => {
      const link = t.querySelector<HTMLElement>('a')!, img = link.querySelector('img');
      return img ? attachDitherHover(link, img, reduced()) : null;
    });

    place(0);
    gsap.ticker.add(() => {
      if (Math.abs(target - p) < 0.0005) return;
      // Follow the finger closely while dragging; ease more gently otherwise
      p += (target - p) * (reduced() ? 1 : dragging ? 0.35 : 0.1);
      place(p);
    });
    window.addEventListener('resize', () => place(p));
    phone.addEventListener('change', () => place(p));
  }
</script>

<style>
  /* One fixed screen; input drives the track instead of page scroll */
  .projects { position: relative; isolation: isolate; height: 100svh; overflow: hidden; overscroll-behavior: none; touch-action: none; }
  .stage { position: absolute; inset: 0; overflow: hidden; }
  :global(html:has(.projects)) { overflow: hidden; }

  /* Project details, bottom left */
  /* Exactly one grid column wide (two on phones), inset from its lines like page content */
  .details {
    --span: 1;
    position: absolute; z-index: 300; bottom: clamp(1.5rem, 4vh, 2.5rem);
    left: calc(var(--gutter) + var(--pad));
    width: calc((100% - 2 * var(--gutter)) / var(--cols) * var(--span) - 2 * var(--pad));
  }
  .sheet { margin: 0; display: grid; grid-template-columns: auto 1fr; }
  .sheet[hidden], .caption[hidden] { display: none; }
  .sheet .name {
    grid-column: 1 / -1; margin: 0 0 0.5rem; padding-bottom: 0.4rem; text-align: left;
    font-family: var(--font-display); font-size: var(--step-2); letter-spacing: -0.05em; line-height: 1;
    border-bottom: 1px solid var(--line);
  }
  .sheet dt, .sheet dd { padding: 0.45rem 0; border-bottom: 1px solid var(--line); }
  .sheet dt { color: var(--mute); font-size: var(--step--2); padding-right: 1.5rem; align-self: stretch; display: flex; align-items: center; }
  .sheet dd { margin: 0; text-align: right; font-size: var(--step--1); }
  .tools { display: flex; flex-direction: column; align-items: end; }


  /* Tiles */
  /* Perspective lives on the track so the text layers stay flat and on top */
  .track { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; z-index: 1; perspective: 1600px; perspective-origin: 50% 40%; }
  .tile {
    --w: min(64vmin, 46rem, 40vw); /* 40vw keeps it clear of the first grid column */
    position: absolute; left: 50%; top: 46%; width: var(--w); aspect-ratio: 1;
    margin: calc(var(--w) / -2) 0 0 calc(var(--w) / -2);
    will-change: transform, opacity;
  }
  .tile a {
    position: relative; display: block; width: 100%; height: 100%; border-radius: 6px; overflow: hidden;
    background: var(--tint);
    box-shadow: inset 0 0 0 1px #ffffff26, 0 40px 80px -30px #0009;
    /* Constant gentle drift, on the link so it adds to the track's own
       positioning; each tile starts at a different point so they never sync */
    animation: float 7s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * -1.9s);
  }
  @keyframes float {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
    25% { transform: translate3d(3px, -7px, 0) rotate(0.4deg); }
    50% { transform: translate3d(0, -11px, 0) rotate(-0.2deg); }
    75% { transform: translate3d(-3px, -5px, 0) rotate(-0.5deg); }
  }
  @media (prefers-reduced-motion: reduce) { .tile a { animation: none; } }
  .tile img { width: 100%; height: 100%; object-fit: cover; }

  /* Pixel dither layer over the image (scripts/ditherHover.ts) */
  .tile :global(.dither-hover) { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; pointer-events: none; }

  /* Summary under the table */
  .caption { margin-top: 0.9rem; }
  .caption p { margin: 0 0 0.5rem; color: var(--mute); }
  .view { border-bottom: 1px solid transparent; transition: border-color 0.3s, color 0.3s; }
  .view:hover { color: var(--accent-text); border-color: currentColor; }

  @media (max-width: 760px) {
    .tile { --w: min(74vw, 24rem); top: 40%; }
    .details { --span: 2; }
    .sheet dt, .sheet dd { padding: 0.3rem 0; }
  }
</style>
