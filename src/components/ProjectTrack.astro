    .lb-title { flex-basis: 100%; }
  }

  /* Design / Photography / Experiments, bottom middle; an accent pill slides to the
     active tab */
  .switch {
    position: absolute; z-index: 310; left: 50%; bottom: clamp(1.5rem, 4vh, 2.5rem); translate: -50% 0;
    display: flex; width: max-content; padding: 4px; border-radius: 999px;
