    transition: grid-template-columns 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s;
  }
  .lbl > span { overflow: hidden; min-width: 0; }
  .lbl > span > span { display: block; padding-left: 0.45rem; white-space: nowrap; }
  .switch button[aria-pressed='true'] .lbl, .switch button:focus-visible .lbl { grid-template-columns: 1fr; opacity: 1; }
  @media (hover: hover) and (pointer: fine) {
    .switch button:hover .lbl { grid-template-columns: 1fr; opacity: 1; }
  }

  /* Project details, bottom left: hidden until a card is hovered */
  /* Exactly one grid column wide (two on phones), inset from its lines like page content */
  .details {
    --span: 1;
    position: absolute; z-index: 300; bottom: clamp(1.5rem, 4vh, 2.5rem);
    left: calc(var(--gutter) + var(--pad));
    width: calc((100% - 2 * var(--gutter)) / var(--cols) * var(--span) - 2 * var(--pad));
    opacity: 0; visibility: hidden; transition: opacity 0.35s, visibility 0s 0.35s;
  }
  .details.on { opacity: 1; visibility: visible; transition: opacity 0.35s; }
  .entry[hidden] { display: none; }
  .name {
    margin: 0 0 0.5rem; padding-bottom: 0.4rem;
    font-family: var(--font-display); font-size: var(--step-2); font-weight: 500; letter-spacing: -0.05em; line-height: 1;
    border-bottom: 1px solid var(--line);
  }
  .sheet { margin: 0; display: grid; grid-template-columns: auto 1fr; }
  .sheet dt, .sheet dd { padding: 0.45rem 0; border-bottom: 1px solid var(--line); }
  .sheet dt { color: var(--mute); font-size: var(--step--2); padding-right: 1.5rem; align-self: stretch; display: flex; align-items: center; }
  .sheet dd { margin: 0; text-align: right; font-size: var(--step--1); }
  .tools { display: flex; flex-direction: column; align-items: end; }

  /* Summary under the table */
  .caption { margin-top: 0.9rem; }
  .caption p { margin: 0 0 0.5rem; color: var(--mute); }
  .view { border-bottom: 1px solid transparent; transition: border-color 0.3s, color 0.3s; }
  .view:hover { color: var(--accent-text); border-color: currentColor; }

  /* Links: visually hidden (but focusable) unless WebGL is missing */
  .fallback {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%);
    list-style: none; margin: 0; padding: 0;
  }
  .no-gl .gl { display: none; }
  .no-gl .fallback {
    position: static; width: auto; height: auto; overflow: visible; clip-path: none;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 1rem;
    padding: 7rem calc(var(--gutter) + var(--pad)) 2rem;
  }
  .no-gl .fallback img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 6px; }
  .no-gl .fallback span { display: block; margin-top: 0.5rem; }
  .no-gl .stage { overflow-y: auto; }

  /* Desktop: the details split across the bottom of the page grid, the title
     (h2 size) in the bottom left and the facts in the last column on the right */
  @media (min-width: 761px) and (hover: hover) and (pointer: fine) {
    .details { left: var(--gutter); right: var(--gutter); width: auto; pointer-events: none; }
    .entry { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); align-items: end; }
    .entry > * { padding-inline: var(--pad); }
    .name { grid-column: 1 / span 2; margin: 0; padding-bottom: 0; border: 0; }
    .info { grid-column: -2 / -1; pointer-events: auto; }
    .info .sheet dt:first-child, .info .sheet dt:first-child + dd { border-top: 1px solid var(--line); }
