  @media (max-width: 760px) {
    /* The toggle takes the very bottom; the details sit just above it */
    .details { --span: 2; bottom: calc(clamp(1.5rem, 4vh, 2.5rem) + 3.25rem); }
    .switch { bottom: clamp(1rem, 3vh, 1.5rem); }
    .switch button { padding: 0.55rem 0.8rem; }
