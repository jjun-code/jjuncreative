---
// Every project as a curved card on a slowly turning cylinder, over the site's
// pixel background. Cards stay level but climb on a diagonal as they come round
// (low on the left, high on the right), like a spiral.
// This is the whole home page. Scrolling, swiping or the arrow keys spin the
// cylinder; hovering a card shows its details in the bottom left (on touch
// screens, the card facing front shows them).
// Cards are built from thin vertical strips set around the curve, so each one
// bends with the cylinder. Projects repeat around the ring to fill it.
import { src } from '../lib/content';
const { work } = Astro.props;
const STRIPS = 12;
const slots = Array.from({ length: Math.max(8, Math.ceil(8 / work.length) * work.length) }, (_, s) => s);
---
<section class="projects" id="work" aria-label="Projects" data-strips={STRIPS} style={`--slots:${slots.length}; --strips:${STRIPS}`}>
  <div class="stage">
    <div class="details" aria-live="polite">
      {work.map((w: any, i: number) => (
        <div class="entry" data-i={i} hidden>
          <dl class="sheet">
            <dt class="visually-hidden">Project</dt>
            <dd class="name">{w.title}</dd>
            <dt class="mono">Category</dt><dd>{w.category}</dd>
            <dt class="mono">Year</dt><dd>{w.year}</dd>
            {w.tools.length > 0 && <><dt class="mono">Tools</dt><dd class="tools">{w.tools.map((t: string) => <span>{t}</span>)}</dd></>}
          </dl>
          <div class="caption">
            <p class="mono">{w.summary}</p>
            <a href={`/work/${w.slug}/`} class="mono view">View project <span aria-hidden="true">→</span></a>
          </div>
        </div>
      ))}
    </div>

    <div class="scene">
      <div class="ring">
        {slots.map((slot) => {
          const i = slot % work.length;
          const w = work[i];
          const art = src(w.cover, 1200) || src(w.inlineImage, 1200) || src(w.gallery[0], 1200);
          // The second lap repeats the first, so screen readers and the tab key skip it
          const repeat = slot >= work.length;
          return (
            <a
              href={`/work/${w.slug}/`} class="card" data-slot={slot} data-i={i} data-cursor="view"
              aria-label={repeat ? undefined : w.title} aria-hidden={repeat ? 'true' : undefined} tabindex={repeat ? -1 : undefined}
              style={`--slot:${slot}; --tint:${w.charm.color}`}
            >
              {Array.from({ length: STRIPS }, (_, j) => (
                <span class="strip" style={`--j:${j}`}>{art && <img src={art} alt="" loading={slot < 3 ? 'eager' : 'lazy'} />}</span>
              ))}
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, reduced } from '../scripts/smooth';
  import { tick } from '../scripts/sound';
  import { onPage } from '../scripts/page';

  onPage(() => {
    const sec = document.querySelector<HTMLElement>('.projects');
    if (!sec) return;
    // Listeners outside the section are removed when the page changes
    const ac = new AbortController();
    const { signal } = ac;

    const ring = sec.querySelector<HTMLElement>('.ring')!;
    const scene = sec.querySelector<HTMLElement>('.scene')!;
    const details = sec.querySelector<HTMLElement>('.details')!;
    const entries = [...sec.querySelectorAll<HTMLElement>('.entry')];
    const cards = [...sec.querySelectorAll<HTMLAnchorElement>('.card')];
    const slots = cards.length;
    const strips = Number(sec.dataset.strips);
    const step = 360 / slots; // degrees between cards
    const ARC = step * 0.74; // each card's share of that, the rest is gap
    // Phones (touch screens or narrow windows) always show the details, for
    // the card at the front; elsewhere they appear on hover
    const mobile = window.matchMedia('(hover: none), (max-width: 760px)');

    // ── Size: card width from the viewport, radius from the card's arc ──
    let cw = 0, degPerPx = 0;
    const size = () => {
      const W = window.innerWidth, H = window.innerHeight;
      cw = Math.min(W < 760 ? W * 0.52 : W * 0.28, H * 0.6, 540);
      const r = cw / ((ARC * Math.PI) / 180);
      sec.style.setProperty('--cw', `${cw}px`);
      sec.style.setProperty('--ch', `${cw * 0.64}px`);
      sec.style.setProperty('--r', `${r}px`);
      sec.style.setProperty('--sa', `${ARC / strips}deg`);
      sec.style.setProperty('--step', `${step}deg`);
      degPerPx = step / (cw * 1.15);
    };
    size();

    // ── Details: shown while a card (or the panel itself) is hovered ──
    let shown = -1, hideTimer = 0;
    const show = (i: number) => {
      clearTimeout(hideTimer);
      if (i === shown) return;
      shown = i;
      entries.forEach((e, k) => (e.hidden = k !== i));
      details.classList.add('on');
      if (!reduced()) gsap.fromTo(entries[i], { y: 14, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6, ease: 'expo.out' });
    };
    const hide = () => {
      clearTimeout(hideTimer);
      if (mobile.matches) { if (front >= 0) show(Number(cards[front].dataset.i)); return; }
      hideTimer = window.setTimeout(() => { details.classList.remove('on'); shown = -1; }, 350);
    };
    // Hover is worked out from the mouse position every frame rather than
    // from pointerenter/leave, which don't fire when the cylinder spins a new
    // card under a mouse that isn't moving
    let hovering = false, mx = 0, my = 0, mouseIn = false, hovered: HTMLElement | null = null;
    const setHover = (c: HTMLElement | null) => {
      if (c === hovered) return;
      hovered?.classList.remove('is-hover');
      hovered = c;
      hovering = !!c;
      if (c) { c.classList.add('is-hover'); show(Number(c.dataset.i)); } else hide();
    };
    const hitTest = () => {
      if (!mouseIn) return;
      setHover(document.elementFromPoint(mx, my)?.closest<HTMLElement>('.card') ?? null);
    };
    sec.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      mx = e.clientX; my = e.clientY; mouseIn = true;
      hitTest();
    });
    sec.addEventListener('pointerleave', () => { mouseIn = false; setHover(null); });
    cards.forEach((c) => {
      c.addEventListener('focus', () => show(Number(c.dataset.i)));
      c.addEventListener('blur', hide);
    });
    details.addEventListener('pointerenter', () => clearTimeout(hideTimer));
    details.addEventListener('pointerleave', hide);

    // ── Motion: a slow constant drift, plus spin from input that coasts out ──
    const DRIFT = -5; // degrees per second, right to left
    let theta = 0, vel = 0, drift = 1, dragging = false, lastInput = -1e9, front = -1;
    const spun = () => (lastInput = performance.now());

    sec.addEventListener('wheel', (e) => {
      e.preventDefault();
      const d = Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
      const px = e.deltaMode === 1 ? d * 40 : d;
      vel = Math.max(-240, Math.min(240, vel - px * 0.35));
      spun();
    }, { passive: false });

    let lastX = 0, lastY = 0, lastT = 0, vx = 0;
    sec.addEventListener('touchstart', (e) => {
      lastX = e.touches[0].clientX; lastY = e.touches[0].clientY; lastT = performance.now();
      dragging = true; vel = 0; vx = 0;
    }, { passive: true });
    sec.addEventListener('touchmove', (e) => {
      const t = e.touches[0], now = performance.now();
      const dx = t.clientX - lastX, dy = t.clientY - lastY;
      // Sideways swipes follow the finger; vertical ones spin too
      const d = Math.abs(dx) >= Math.abs(dy) ? dx : -dy;
      theta += d * degPerPx;
      vx = (d * degPerPx * 1000) / Math.max(1, now - lastT);
      lastX = t.clientX; lastY = t.clientY; lastT = now;
      spun();
    }, { passive: true });
    sec.addEventListener('touchend', () => { dragging = false; vel = Math.max(-300, Math.min(300, vx)); });

    window.addEventListener('keydown', (e) => {
      const el = e.target instanceof Element ? e.target : null;
      if (el?.closest('input, textarea, [contenteditable]')) return;
      // vel decays at 3/s, so 3 × step coasts exactly one card
      if (['ArrowDown', 'ArrowRight', 'PageDown'].includes(e.key)) { e.preventDefault(); vel -= step * 3; spun(); }
      if (['ArrowUp', 'ArrowLeft', 'PageUp'].includes(e.key)) { e.preventDefault(); vel += step * 3; spun(); }
    }, { signal });

    // Angle of each card relative to the front, in -180..180
    const rel = (slot: number) => ((((slot * step + theta) % 360) + 540) % 360) - 180;

    const place = () => {
      ring.style.setProperty('--theta', `${theta}deg`);
      let nearest = 0, best = 999;
      cards.forEach((c, slot) => {
        const a = Math.abs(rel(slot));
        if (a < best) { best = a; nearest = slot; }
        // Focus: 1 for the card at the front, falling off smoothly to ~0 by
        // the next card along. It sizes the card up and keeps it bright and
        // solid; cards to the sides shrink and fade into the page, then turn
        // fully transparent as they reach the edge.
        const f = Math.exp(-((a / 22) ** 2));
        c.style.setProperty('--k', (0.84 + 0.42 * f).toFixed(3));
        c.style.setProperty('--fade', (0.62 * (1 - f)).toFixed(3));
        c.style.setProperty('--o', Math.max(0, Math.min(1, (100 - a) / 35)).toFixed(3));
        // The diagonal: cards to the right of the front sit higher, to the left lower
        c.style.setProperty('--y', `${(-rel(slot) / 60) * cw * 0.26}px`);
        c.style.pointerEvents = a < 70 ? 'auto' : 'none';
      });
      if (nearest !== front) {
        front = nearest;
        // Tick only when the visitor is spinning it, not on the idle drift
        if (performance.now() - lastInput < 1200) tick();
        if (mobile.matches && !hovered) show(Number(cards[front].dataset.i));
      }
    };

    const rm = reduced();
    const frame = (_t: number, dtMs: number) => {
      const dt = Math.min(dtMs, 50) / 1000;
      // The drift eases off while a card is hovered, so it holds still to read
      drift += ((hovering || rm ? 0 : 1) - drift) * Math.min(1, dt * 4);
      if (!dragging) {
        theta += (DRIFT * drift + vel) * dt;
        vel *= Math.exp(-3 * dt);
        if (Math.abs(vel) < 0.01) vel = 0;
      }
      place();
      hitTest();
    };
    place();
    gsap.ticker.add(frame);
    window.addEventListener('resize', () => { size(); place(); }, { signal });
    mobile.addEventListener('change', () => {
      if (mobile.matches) show(Number(cards[front].dataset.i));
      else { setHover(null); hide(); }
    }, { signal });

    // Entrance plays as the loader dissolves, or straight away on later pages
    const intro = () => {
      if (rm) return;
      gsap.from(scene, { opacity: 0, scale: 0.8, y: 60, duration: 1.8, ease: 'expo.out' });
      vel = -160; // a quick spin in
    };
    if (document.documentElement.classList.contains('is-loading')) {
      window.addEventListener('loader:reveal', intro, { once: true, signal });
    } else {
      gsap.delayedCall(0.15, intro);
    }

    return () => {
      ac.abort();
      gsap.ticker.remove(frame);
      clearTimeout(hideTimer);
    };
  });
</script>

<style>
  /* One fixed screen; input spins the cylinder instead of scrolling the page */
  .projects { position: relative; isolation: isolate; height: 100svh; overflow: hidden; overscroll-behavior: none; touch-action: none; }
  .stage { position: absolute; inset: 0; overflow: hidden; }
  :global(html:has(.projects)) { overflow: hidden; }

  /* Project details, bottom left: hidden until a card is hovered */
  /* Exactly one grid column wide (two on phones), inset from its lines like page content */
  .details {
    --span: 1;
    position: absolute; z-index: 300; bottom: clamp(1.5rem, 4vh, 2.5rem);
    left: calc(var(--gutter) + var(--pad));
    width: calc((100% - 2 * var(--gutter)) / var(--cols) * var(--span) - 2 * var(--pad));
    opacity: 0; visibility: hidden; transition: opacity 0.35s, visibility 0s 0.35s;
  }
  .details.on { opacity: 1; visibility: visible; transition: opacity 0.35s; }
  .entry[hidden] { display: none; }
  .sheet { margin: 0; display: grid; grid-template-columns: auto 1fr; }
  .sheet .name {
    grid-column: 1 / -1; margin: 0 0 0.5rem; padding-bottom: 0.4rem; text-align: left;
    font-family: var(--font-display); font-size: var(--step-2); letter-spacing: -0.05em; line-height: 1;
    border-bottom: 1px solid var(--line);
  }
  .sheet dt, .sheet dd { padding: 0.45rem 0; border-bottom: 1px solid var(--line); }
  .sheet dt { color: var(--mute); font-size: var(--step--2); padding-right: 1.5rem; align-self: stretch; display: flex; align-items: center; }
  .sheet dd { margin: 0; text-align: right; font-size: var(--step--1); }
  .tools { display: flex; flex-direction: column; align-items: end; }

  /* Summary under the table */
  .caption { margin-top: 0.9rem; }
  .caption p { margin: 0 0 0.5rem; color: var(--mute); }
  .view { border-bottom: 1px solid transparent; transition: border-color 0.3s, color 0.3s; }
  .view:hover { color: var(--accent-text); border-color: currentColor; }

  /* ── Cylinder ── */
  .scene { position: absolute; inset: 0; z-index: 1; perspective: 1700px; perspective-origin: 50% 44%; }
  /* Pushed back by its radius so the front cards sit at screen depth, seen from
     a touch above, and spun by --theta from the script */
  .ring {
    position: absolute; left: 50%; top: 46%; width: 0; height: 0;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--r, 900px) * -1)) rotateX(-4deg) rotateY(var(--theta, 0deg));
  }
  .card {
    position: absolute; left: 0; top: 0; transform-style: preserve-3d;
    transform: rotateY(calc(var(--slot) * var(--step, 36deg))) translateY(var(--y, 0px));
    /* Gentle bob, out of step from card to card */
    animation: bob 7s ease-in-out infinite; animation-delay: calc(var(--slot) * -1.3s);
  }
  @keyframes bob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -12px; }
  }
  /* One slice of the card, angled to sit on the curve. Each shows its part of
     the full-size image, so together they read as one bent card. */
  .strip {
    position: absolute; overflow: hidden;
    width: calc(var(--cw, 400px) / var(--strips) + 1px); height: var(--ch, 256px);
    margin: calc(var(--ch, 256px) / -2) 0 0 calc(var(--cw, 400px) / var(--strips) / -2);
    /* --k scales the whole card: each slice grows and moves out by the same
       factor, so the slices still meet edge to edge */
    transform: rotateY(calc((var(--j) - (var(--strips) - 1) / 2) * var(--sa, 2deg))) translateZ(calc(var(--r, 900px) * var(--k, 1))) scale(var(--k, 1));
    backface-visibility: hidden;
    background: var(--tint);
    opacity: var(--o, 1);
  }
  /* Fades the card toward the page colour. Done inside each (opaque) slice
     rather than with opacity, so the slices' 1px overlaps don't show as lines. */
  .strip::after {
    content: ''; position: absolute; inset: 0; background: var(--bg);
    opacity: var(--fade, 0); transition: opacity 0.3s;
  }
  .strip img {
    position: absolute; top: 0; left: calc(var(--j) * var(--cw, 400px) / var(--strips) * -1);
    width: var(--cw, 400px); height: var(--ch, 256px); max-width: none; object-fit: cover;
  }
  .strip:first-child { border-radius: 6px 0 0 6px; }
  .strip:last-child { border-radius: 0 6px 6px 0; }
  /* A hovered side card comes partly out of the fade */
  .card.is-hover .strip::after, .card:focus-visible .strip::after { opacity: calc(var(--fade, 0) * 0.4); }
  .card:focus-visible { outline: none; }
  @media (prefers-reduced-motion: reduce) { .card { animation: none; } }

  @media (max-width: 760px) {
    .ring { top: 40%; }
    .details { --span: 2; }
    .sheet dt, .sheet dd { padding: 0.3rem 0; }
  }
</style>
