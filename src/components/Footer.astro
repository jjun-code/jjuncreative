---
import Button from './Button.astro';
const { site } = Astro.props;
---
<footer class="footer wrap" id="contact">
  <div class="cta card" data-reveal>
    <div class="cta-copy">
      <p class="label">Say hello</p>
      <h2 class="h1">Got something in mind? <span class="mute">Let's make it together.</span></h2>
    </div>
    <div class="cta-side">
      <p class="avail"><span class="led" aria-hidden="true"></span>{site.availability}</p>
      <div class="buttons">
        <Button variant="accent" href={`mailto:${site.email}`} sub={site.email}>Email me</Button>
        <Button data-copy={site.email}><span class="copy-text">Copy email</span></Button>
      </div>
      <ul class="socials">
        {site.socials.map((s: any) => <li><a class="tag" href={s.url} target="_blank" rel="noopener">{s.label} ↗</a></li>)}
      </ul>
    </div>
  </div>

  <div class="meta">
    <span>{site.location} · {site.coordinates}</span>
    <span>© {new Date().getFullYear()} jjuncreative</span>
  </div>
  <hr class="rule" />
  <p class="giant" aria-hidden="true">JJUNCREATIVE</p>
</footer>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const text = btn.querySelector('.copy-text');
    if (!text) return;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        text.textContent = 'Copied';
      } catch {
        window.location.href = `mailto:${btn.dataset.copy}`;
      }
      setTimeout(() => (text.textContent = 'Copy email'), 2000);
    });
  });
</script>

<style>
  .footer { padding-top: clamp(4rem, 10vw, 8rem); overflow: hidden; position: relative; }
  .cta {
    display: grid; grid-template-columns: 1.3fr 1fr; gap: 3rem; align-items: end;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    background:
      radial-gradient(120% 140% at 100% 0%, #ff4d0022, transparent 55%),
      var(--panel);
  }
  .cta h2 { max-width: 13ch; }
  .avail { display: flex; gap: 0.6rem; align-items: baseline; color: var(--mute); max-width: 34ch; }
  .led { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent); animation: blink 2.4s steps(1) infinite; translate: 0 -1px; }
  @keyframes blink { 50% { opacity: 0.25; } }
  .buttons { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 1.5rem 0; }
  .socials { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .socials a:hover { color: var(--ink); border-color: #ffffff40; }
  .meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-block: 2.5rem 1.2rem; font-size: var(--step--1); color: var(--dim); }
  @media (max-width: 860px) {
    .cta { grid-template-columns: 1fr; }
  }
</style>
