---
import Button from './Button.astro';
import Logo from './Logo.astro';
const { site } = Astro.props;
---
<footer class="footer grid" id="contact">
  <div class="cta-copy c-2" data-reveal>
    <p class="label">Say hello</p>
    <h2 class="h1">Got something in mind? <span class="mute">Let's make it together.</span></h2>
  </div>
  <div class="cta-side c-2" data-reveal>
    <p class="avail"><span class="led" aria-hidden="true"></span>{site.availability}</p>
    <div class="buttons">
      <Button variant="accent" href={`mailto:${site.email}`} sub={site.email}>Email me</Button>
      <Button data-copy={site.email}><span class="copy-text">Copy email</span></Button>
    </div>
    <ul class="socials">
      {site.socials.map((s: any) => <li><a class="tag" href={s.url} target="_blank" rel="noopener">{s.label} ↗</a></li>)}
    </ul>
  </div>

  <div class="meta c-full sub">
    <span class="c-2">{site.location} · {site.coordinates}</span>
    <span class="c-2">© {new Date().getFullYear()} jjuncreative</span>
  </div>
  <div class="c-full"><Logo class="foot-logo" /></div>
</footer>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const text = btn.querySelector('.copy-text');
    if (!text) return;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        text.textContent = 'Copied';
      } catch {
        window.location.href = `mailto:${btn.dataset.copy}`;
      }
      setTimeout(() => (text.textContent = 'Copy email'), 2000);
    });
  });
</script>

<style>
  /* Footer sits on the page grid: message left half, actions right half */
  .footer { padding-top: clamp(4rem, 10vw, 8rem); overflow: hidden; position: relative; align-items: end; row-gap: 2.5rem; }
  .cta-copy { border-top: 1px solid var(--line); padding-top: 1rem; }
  .cta-copy h2 { max-width: 13ch; }
  .avail { display: flex; gap: 0.6rem; align-items: baseline; color: var(--mute); max-width: 34ch; }
  .led { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent); animation: blink 2.4s steps(1) infinite; translate: 0 -1px; }
  @keyframes blink { 50% { opacity: 0.25; } }
  .buttons { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 1.5rem 0; }
  .socials { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .socials a:hover { color: var(--ink); border-color: var(--line-strong); }
  .meta { padding-top: 1rem; border-top: 1px solid var(--line); font-size: var(--step--1); color: var(--dim); }
  .meta span:last-child { text-align: right; }
  .footer :global(.foot-logo) { width: 100%; padding-bottom: 1.6rem; }
  @media (max-width: 760px) {
    .cta-copy, .cta-side { grid-column: 1 / -1; }
    .meta span { grid-column: 1 / -1; text-align: left !important; }
  }
</style>
