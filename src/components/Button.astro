---
// Pill button with a round arrow badge, as on the reference site.
interface Props {
  href?: string;
  variant?: 'accent' | 'ghost';
  sub?: string;
  external?: boolean;
  [attr: string]: any;
}
const { href, variant = 'ghost', sub, external, class: cls, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag
  href={href}
  type={href ? undefined : 'button'}
  class:list={['btn', variant, cls]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  {...rest}
>
  <span class="badge" aria-hidden="true">
    <svg viewBox="0 0 20 20" width="18" height="18"><path d="M3 10h13M11 4.5 16.5 10 11 15.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </span>
  <span class="text">
    <span class="main"><slot /></span>
    {sub && <span class="sub">{sub}</span>}
  </span>
</Tag>

<style>
  .btn {
    position: relative; isolation: isolate; overflow: hidden;
    display: inline-flex; align-items: center; gap: 0.85rem;
    min-height: 3rem; padding: 4px 1.6rem 4px 4px; border-radius: 99px;
    font-size: 1rem; line-height: 1.05; text-align: left;
    transition: color 0.45s var(--ease), border-color 0.45s;
  }
  /* White fill that sweeps in from the badge on hover */
  .btn::before {
    content: ''; position: absolute; z-index: -1; inset: 3px; border-radius: inherit;
    background: #fff; clip-path: circle(1.3rem at 1.5rem 50%);
    opacity: 0; transition: clip-path 0.6s var(--ease), opacity 0.2s;
  }
  .btn:hover::before, .btn:focus-visible::before { clip-path: circle(150% at 1.5rem 50%); opacity: 1; }
  .btn:hover, .btn:focus-visible { color: #141414; }
  .badge {
    flex: none; width: 2.5rem; height: 2.5rem; border-radius: 50%;
    display: grid; place-items: center; overflow: hidden;
    transition: background-color 0.45s, color 0.45s;
  }
  .badge svg { transition: transform 0.6s var(--ease); }
  .btn:hover .badge svg, .btn:focus-visible .badge svg { transform: translateX(2px); }
  .text { display: grid; }
  .sub { font-size: 0.7rem; opacity: 0.8; letter-spacing: -0.01em; }

  .accent { background: var(--accent); color: var(--accent-ink); }
  .accent .badge { background: var(--accent-ink); color: var(--accent); }
  .accent:hover .badge, .accent:focus-visible .badge { background: var(--accent); color: #fff; }

  .ghost { border: 1px solid #ffffff40; color: var(--ink); background: #ffffff0a; backdrop-filter: blur(6px); }
  .ghost .badge { background: var(--ink); color: #141414; }
  .ghost:hover, .ghost:focus-visible { border-color: #fff; }
  .ghost:hover .badge, .ghost:focus-visible .badge { background: #141414; color: #fff; }
</style>
