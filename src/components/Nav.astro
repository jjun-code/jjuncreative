---
const { site } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="nav wrap">
  <a href="/" class="mark" aria-label="jjuncreative home"><span aria-hidden="true">jj</span></a>

  <div class="actions">
    <a href="/contact" class="round accent" aria-label="Contact">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M4 5.5h12a1 1 0 0 1 1 1v6.5a1 1 0 0 1-1 1H9l-3.5 2.5V14H4a1 1 0 0 1-1-1V6.5a1 1 0 0 1 1-1Z" fill="currentColor" /><circle cx="7.5" cy="10" r="0.9" fill="var(--accent)" /><circle cx="10" cy="10" r="0.9" fill="var(--accent)" /><circle cx="12.5" cy="10" r="0.9" fill="var(--accent)" /></svg>
    </a>
    <button class="round menu-btn" aria-expanded="false" aria-controls="menu" aria-label="Menu">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </button>
  </div>

  <nav id="menu" class="menu card" aria-label="Main" hidden>
    <p class="label">Menu</p>
    <ol>
      {links.map((l, i) => (
        <li>
          <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="roll" aria-hidden="true"><span><span>{l.label}</span><span>{l.label}</span></span></span>
            <span class="visually-hidden">{l.label}</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="menu-foot">
      <a href={`mailto:${site.email}`} class="sweep">{site.email}</a>
      <ul>
        {site.socials.map((s: any) => <li><a href={s.url} target="_blank" rel="noopener" class="sweep">{s.label}</a></li>)}
      </ul>
    </div>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('menu');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('open'));
      } else {
        menu.classList.remove('open');
        setTimeout(() => { if (!menu.classList.contains('open')) menu.hidden = true; }, 350);
      }
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { set(false); btn.focus(); }
    });
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (btn.getAttribute('aria-expanded') === 'true' && !menu.contains(t) && !btn.contains(t)) set(false);
    });
  }
</script>

<style>
  .nav {
    position: fixed; inset: 0 0 auto; z-index: 50;
    display: flex; justify-content: space-between; align-items: center;
    padding-block: 1.25rem;
    pointer-events: none;
  }
  .nav a, .nav button, .menu { pointer-events: auto; }
  .mark {
    height: 2.75rem; display: flex; align-items: center; color: #fff;
    font-size: 1.9rem; font-weight: 700; letter-spacing: -0.1em; line-height: 1;
    transition: opacity 0.3s;
  }
  .mark:hover { opacity: 0.7; }
  .actions { display: flex; gap: 0.5rem; }
  .round {
    width: 2.75rem; height: 2.75rem; border-radius: 50%;
    display: grid; place-items: center;
    background: #262626e6; border: 1px solid var(--line); color: var(--ink);
    backdrop-filter: blur(8px);
    transition: background-color 0.3s, transform 0.4s var(--ease);
  }
  .round:hover { transform: scale(1.06); }
  .round.accent { background: var(--accent); border-color: transparent; color: var(--accent-ink); }

  .dots { display: grid; grid-template-columns: 5px 5px; gap: 5px; transition: transform 0.5s var(--ease); }
  .dots i { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .menu-btn[aria-expanded='true'] .dots { transform: rotate(45deg); }

  .menu {
    position: absolute; top: calc(100% - 0.25rem); right: var(--gutter);
    width: min(360px, calc(100vw - 2 * var(--gutter)));
    padding: 1.4rem 1.4rem 1.2rem; background: #232323f5; backdrop-filter: blur(14px);
    opacity: 0; translate: 0 -8px; transform-origin: top right; scale: 0.97;
    transition: opacity 0.3s, translate 0.4s var(--ease), scale 0.4s var(--ease);
  }
  .menu.open { opacity: 1; translate: 0 0; scale: 1; }
  .menu ol { list-style: none; margin: 0; padding: 0; }
  .menu ol a {
    display: flex; align-items: baseline; gap: 0.9rem; padding: 0.35rem 0;
    font-size: 2rem; letter-spacing: -0.05em; color: var(--mute); transition: color 0.3s;
  }
  .menu ol a:hover, .menu ol a[aria-current='page'] { color: var(--ink); }
  .menu-foot { margin-top: 1.4rem; padding-top: 1rem; border-top: 1px solid var(--line); font-size: var(--step--1); color: var(--mute); display: grid; gap: 0.6rem; }
  .menu-foot ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1rem; }
  .menu-foot a:hover { color: var(--ink); }
</style>
