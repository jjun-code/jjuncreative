---
import Logo from './Logo.astro';
import { getSite } from '../lib/content';
const site = await getSite();
---
<header class="nav wrap">
  <a href="/" class="mark" aria-label="jjuncreative home"><Logo /></a>

  <div class="actions">
    <!-- Settings first, then where to go, with the main action at the far
         right. Each button widens to show its label on hover (desktop). The
         primary one opens the message window in the bottom-right corner (Compose.astro;
         the mailto link is for when scripts don't run) -->
    <button class="round sound-btn" aria-pressed="true" aria-label="Sound">
      <span class="ico"><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M3.5 7.5h2.6L10 4.4v11.2l-3.9-3.1H3.5Z" fill="currentColor" /><g class="waves" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M12.8 7.4a3.6 3.6 0 0 1 0 5.2" /><path d="M14.9 5.3a6.6 6.6 0 0 1 0 9.4" /></g><path class="off" d="M12.6 7.6l4.6 4.8M17.2 7.6l-4.6 4.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg></span>
      <span class="lbl" aria-hidden="true"><span><span>Sound</span></span></span>
    </button>
    <button class="round theme-btn" aria-label="Switch to light mode">
      <span class="ico"><svg class="sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="3.6" fill="currentColor" /><g stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M10 2.2v1.6M10 16.2v1.6M2.2 10h1.6M16.2 10h1.6M4.5 4.5l1.1 1.1M14.4 14.4l1.1 1.1M4.5 15.5l1.1-1.1M14.4 5.6l1.1-1.1" /></g></svg>
      <svg class="moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M15.8 12.6A6.5 6.5 0 0 1 7.4 4.2a6.5 6.5 0 1 0 8.4 8.4Z" fill="currentColor" /></svg></span>
      <span class="lbl" aria-hidden="true"><span><span>Theme</span></span></span>
    </button>
    <a href="/about" class="round" aria-label="About">
      <span class="ico"><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="6.8" r="3.3" fill="currentColor" /><path d="M3.5 17a6.5 6.5 0 0 1 13 0Z" fill="currentColor" /></svg></span>
      <span class="lbl" aria-hidden="true"><span><span>About</span></span></span>
    </a>
    <a href={`mailto:${site.email}`} class="round accent" aria-label="Send a message" data-compose>
      <span class="ico"><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="1.5" fill="currentColor" /><path d="m3.5 6 6.5 5 6.5-5" fill="none" stroke="var(--btn)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
      <span class="lbl" aria-hidden="true"><span><span>Message</span></span></span>
    </a>
  </div>

</header>

<script>
  import { isMuted, setMuted } from '../scripts/sound';
  import { onPage } from '../scripts/page';

  onPage(() => {
    const ac = new AbortController();
    const { signal } = ac;

    // Sound on/off. Remembered across visits.
    const soundBtn = document.querySelector<HTMLButtonElement>('.sound-btn');
    if (soundBtn) {
      const show = () => {
        const on = !isMuted();
        soundBtn.setAttribute('aria-pressed', String(on));
        soundBtn.setAttribute('aria-label', on ? 'Turn sound off' : 'Turn sound on');
      };
      show();
      soundBtn.addEventListener('click', () => { setMuted(!isMuted()); show(); });
    }

    // Light/dark toggle. The head script in Base sets the initial theme.
    const themeBtn = document.querySelector<HTMLButtonElement>('.theme-btn');
    if (themeBtn) {
      const label = () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        themeBtn.setAttribute('aria-label', `Switch to ${next} mode`);
      };
      label();
      themeBtn.addEventListener('click', () => {
        const t = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
        try { localStorage.setItem('theme', t); } catch {}
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', t === 'light' ? '#ffffff' : '#0b0b0b');
        label();
        window.dispatchEvent(new CustomEvent('themechange', { detail: t }));
      });
    }

    return () => ac.abort();
  });
</script>

<style>
  .nav {
    position: fixed; inset: 0 0 auto; z-index: 50;
    padding-inline: calc(var(--gutter) + var(--pad));
    display: flex; justify-content: space-between; align-items: center;
    padding-block: 1.25rem;
    pointer-events: none;
  }
  .nav a, .nav button { pointer-events: auto; }
  .mark { height: 2.75rem; display: flex; align-items: center; color: var(--ink); transition: opacity 0.3s; }
  .mark :global(.logo) { width: clamp(6.5rem, 5rem + 4vw, 8.5rem); }
  .mark:hover { opacity: 0.7; }
  .actions { display: flex; gap: 0.5rem; }
  .round {
    height: 2.75rem; min-width: 2.75rem; padding: 0; border-radius: 999px;
    display: inline-flex; align-items: center;
    background: var(--glass); border: 1px solid var(--line); color: var(--ink);
    backdrop-filter: blur(8px);
    transition: background-color 0.3s, opacity 0.15s ease-out;
  }
  .round.accent { background: var(--btn); border-color: transparent; color: var(--btn-ink); }
  .round:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
  /* Icon in a fixed circle-sized box at the left */
  .ico {
    flex: none; display: grid; place-items: center; width: calc(2.75rem - 2px); height: 100%;
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .round:active .ico { transform: scale(0.94); transition-duration: 60ms; }
  /* Label: a 0fr → 1fr grid column, so the pill grows to fit the text */
  .lbl {
    display: grid; grid-template-columns: 0fr; opacity: 0; translate: 5px 0;
    font-size: var(--step--1); font-weight: 500; letter-spacing: -0.01em;
    transition: grid-template-columns 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 80ms ease-out, translate 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .lbl > span { overflow: hidden; min-width: 0; }
  .lbl > span > span { display: block; padding-right: 1rem; white-space: nowrap; }
  @media (hover: hover) and (pointer: fine) and (min-width: 761px) {
    .round:hover .lbl, .round:focus-visible .lbl { grid-template-columns: 1fr; opacity: 1; translate: 0 0; }
    .round:hover .ico { transform: scale(1.04); }
    /* The others step back while one is hovered */
    .actions:has(.round:hover) .round:not(:hover) { opacity: 0.5; }
  }
  .sound-btn .off { display: none; }
  .sound-btn[aria-pressed='false'] .off { display: block; }
  .sound-btn[aria-pressed='false'] .waves { display: none; }
  /* Show the icon for the theme you'd switch to */
  .theme-btn svg { transition: transform 0.5s var(--ease); }
  .theme-btn:hover svg { transform: rotate(-20deg); }
  :global([data-theme='light']) .theme-btn .sun, :global([data-theme='dark']) .theme-btn .moon { display: none; }

</style>
