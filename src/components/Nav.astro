---
import Logo from './Logo.astro';
const { site } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="nav wrap">
  <a href="/" class="mark" aria-label="jjuncreative home"><Logo /></a>

  <div class="actions">
    <a href="/contact" class="round accent" aria-label="Contact">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M4 5.5h12a1 1 0 0 1 1 1v6.5a1 1 0 0 1-1 1H9l-3.5 2.5V14H4a1 1 0 0 1-1-1V6.5a1 1 0 0 1 1-1Z" fill="currentColor" /><circle cx="7.5" cy="10" r="0.9" fill="var(--accent)" /><circle cx="10" cy="10" r="0.9" fill="var(--accent)" /><circle cx="12.5" cy="10" r="0.9" fill="var(--accent)" /></svg>
    </a>
    <button class="round sound-btn" aria-pressed="true" aria-label="Sound">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M3.5 7.5h2.6L10 4.4v11.2l-3.9-3.1H3.5Z" fill="currentColor" /><g class="waves" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M12.8 7.4a3.6 3.6 0 0 1 0 5.2" /><path d="M14.9 5.3a6.6 6.6 0 0 1 0 9.4" /></g><path class="off" d="M12.6 7.6l4.6 4.8M17.2 7.6l-4.6 4.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </button>
    <button class="round theme-btn" aria-label="Switch to light mode">
      <svg class="sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="3.6" fill="currentColor" /><g stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M10 2.2v1.6M10 16.2v1.6M2.2 10h1.6M16.2 10h1.6M4.5 4.5l1.1 1.1M14.4 14.4l1.1 1.1M4.5 15.5l1.1-1.1M14.4 5.6l1.1-1.1" /></g></svg>
      <svg class="moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M15.8 12.6A6.5 6.5 0 0 1 7.4 4.2a6.5 6.5 0 1 0 8.4 8.4Z" fill="currentColor" /></svg>
    </button>
    <button class="round menu-btn" aria-expanded="false" aria-controls="menu" aria-label="Menu">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </button>
  </div>

</header>

<!-- Full-screen menu: a dither veil sweeps in from the menu button, then the
     links rise into place on the page grid -->
<div id="menu" class="menu" hidden>
  <canvas class="menu-veil" aria-hidden="true"></canvas>
  <div class="menu-body grid">
    <div class="menu-side c-1">
      <p class="label">Menu</p>
      <dl class="menu-info mono">
        <div><dt>Local time</dt><dd><span class="clock">--:--:--</span> NZ</dd></div>
        <div><dt>Based in</dt><dd>{site.location}</dd></div>
        <div><dt>Email</dt><dd><a href={`mailto:${site.email}`} class="sweep">{site.email}</a></dd></div>
        <div><dt>Elsewhere</dt><dd class="socials">{site.socials.map((s: any) => <a href={s.url} target="_blank" rel="noopener" class="sweep">{s.label} ↗</a>)}</dd></div>
      </dl>
    </div>
    <nav class="menu-links c-3" aria-label="Main">
      <ol>
        {links.map((l, i) => (
          <li>
            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
              <span class="idx mono">({String(i + 1).padStart(2, '0')})</span>
              <span class="pip" aria-hidden="true"></span>
              <span class="word" aria-hidden="true">
                {[...l.label].map((ch, j) => <span class="ch" style={`--j:${j}`}><span>{ch}</span><span>{ch}</span></span>)}
              </span>
              <span class="visually-hidden">{l.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</div>

<script>
  import { isMuted, setMuted, tick } from '../scripts/sound';
  import { gsap, reduced, getLenis } from '../scripts/smooth';
  import { makeVeil } from '../scripts/veil';

  // Sound on/off. Remembered across visits.
  const soundBtn = document.querySelector<HTMLButtonElement>('.sound-btn');
  if (soundBtn) {
    const show = () => {
      const on = !isMuted();
      soundBtn.setAttribute('aria-pressed', String(on));
      soundBtn.setAttribute('aria-label', on ? 'Turn sound off' : 'Turn sound on');
    };
    show();
    soundBtn.addEventListener('click', () => { setMuted(!isMuted()); show(); });
  }

  // Light/dark toggle. The head script in Base sets the initial theme.
  const themeBtn = document.querySelector<HTMLButtonElement>('.theme-btn');
  if (themeBtn) {
    const label = () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      themeBtn.setAttribute('aria-label', `Switch to ${next} mode`);
    };
    label();
    themeBtn.addEventListener('click', () => {
      const t = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = t;
      try { localStorage.setItem('theme', t); } catch {}
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', t === 'light' ? '#f1f1ef' : '#141414');
      label();
      window.dispatchEvent(new CustomEvent('themechange', { detail: t }));
    });
  }

  // ── Menu ──
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('menu');
  if (btn && menu) {
    const veil = makeVeil(menu.querySelector<HTMLCanvasElement>('.menu-veil')!, { cell: 12, from: 'top-right' });
    const words = [...menu.querySelectorAll<HTMLElement>('.menu-links li')];
    const side = [...menu.querySelectorAll<HTMLElement>('.menu-side > *')];
    const clock = menu.querySelector<HTMLElement>('.clock')!;
    const fmt = new Intl.DateTimeFormat('en-NZ', {
      timeZone: 'Pacific/Auckland', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
    });
    const rm = reduced();
    const v = { t: 1 };
    let clockTimer = 0;
    let tl: ReturnType<typeof gsap.timeline> | null = null;

    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
      document.documentElement.classList.toggle('menu-open', open);
      tl?.kill();
      if (open) {
        menu.hidden = false;
        getLenis()?.stop();
        const tickClock = () => (clock.textContent = fmt.format(new Date()));
        tickClock();
        clockTimer = window.setInterval(tickClock, 1000);
        veil.size();
        tl = gsap.timeline()
          .to(v, { t: 0, duration: rm ? 0.01 : 0.6, ease: 'power2.inOut', onUpdate: () => veil.draw(v.t) })
          .fromTo(words, { yPercent: 110, opacity: 0 }, { yPercent: 0, opacity: 1, duration: rm ? 0.01 : 0.9, ease: 'expo.out', stagger: 0.06 }, rm ? 0 : 0.3)
          .fromTo(side, { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: rm ? 0.01 : 0.8, ease: 'expo.out', stagger: 0.05 }, rm ? 0 : 0.4);
        menu.querySelector<HTMLElement>('.menu-links a')?.focus({ preventScroll: true });
      } else {
        clearInterval(clockTimer);
        tl = gsap.timeline({ onComplete: () => { menu.hidden = true; getLenis()?.start(); } })
          .to([...words, ...side], { yPercent: -30, opacity: 0, duration: rm ? 0.01 : 0.35, ease: 'power2.in', stagger: 0.02 })
          .to(v, { t: 1, duration: rm ? 0.01 : 0.55, ease: 'power2.inOut', onUpdate: () => veil.draw(v.t) }, rm ? 0 : 0.15);
      }
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { set(false); btn.focus(); }
    });
    // A soft tick as you move over the links
    menu.querySelectorAll('.menu-links a').forEach((a) => a.addEventListener('pointerenter', () => tick()));
  }
</script>

<style>
  .nav {
    position: fixed; inset: 0 0 auto; z-index: 50;
    padding-inline: calc(var(--gutter) + var(--pad));
    display: flex; justify-content: space-between; align-items: center;
    padding-block: 1.25rem;
    pointer-events: none;
  }
  .nav a, .nav button { pointer-events: auto; }
  .mark { height: 2.75rem; display: flex; align-items: center; color: var(--ink); transition: opacity 0.3s; }
  .mark :global(.logo) { width: clamp(6.5rem, 5rem + 4vw, 8.5rem); }
  .mark:hover { opacity: 0.7; }
  .actions { display: flex; gap: 0.5rem; }
  .round {
    width: 2.75rem; height: 2.75rem; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--glass); border: 1px solid var(--line); color: var(--ink);
    backdrop-filter: blur(8px);
    transition: background-color 0.3s, transform 0.4s var(--ease);
  }
  .round:hover { transform: scale(1.06); }
  .round.accent { background: var(--accent); border-color: transparent; color: var(--accent-ink); }
  .sound-btn .off { display: none; }
  .sound-btn[aria-pressed='false'] .off { display: block; }
  .sound-btn[aria-pressed='false'] .waves { display: none; }
  /* Show the icon for the theme you'd switch to */
  .theme-btn svg { transition: transform 0.5s var(--ease); }
  .theme-btn:hover svg { transform: rotate(-20deg); }
  :global([data-theme='light']) .theme-btn .sun, :global([data-theme='dark']) .theme-btn .moon { display: none; }

  .dots { display: grid; grid-template-columns: 5px 5px; gap: 5px; transition: transform 0.5s var(--ease); }
  .dots i { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .menu-btn[aria-expanded='true'] .dots { transform: rotate(45deg); }

  /* ── Full-screen menu ── */
  .menu { position: fixed; inset: 0; z-index: 45; }
  .menu-veil { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; }
  :global(html.menu-open) { overflow: hidden; }
  .menu-body { position: relative; height: 100%; padding-top: calc(5.5rem + 2rem); padding-bottom: 2rem; }

  .menu-side { display: flex; flex-direction: column; justify-content: space-between; }
  .menu-info { margin: 0; display: grid; gap: 1rem; }
  .menu-info div { border-top: 1px solid var(--line); padding-top: 0.6rem; }
  .menu-info dt { color: var(--dim); }
  .menu-info dd { margin: 0; color: var(--ink); text-transform: none; font-size: 0.8rem; }
  .menu-info .socials { display: flex; gap: 1rem; flex-wrap: wrap; }
  .clock { font-variant-numeric: tabular-nums; }

  .menu-links { align-self: end; }
  .menu-links ol { list-style: none; margin: 0; padding: 0; }
  .menu-links li { overflow: hidden; border-top: 1px solid var(--line); }
  .menu-links li:last-child { border-bottom: 1px solid var(--line); }
  .menu-links a {
    display: flex; align-items: center; gap: clamp(0.8rem, 2vw, 2rem);
    padding-block: 0.12em;
    font-size: clamp(3rem, 1rem + 7.5vw, 9rem); font-weight: 500; letter-spacing: -0.06em; line-height: 0.95;
    color: var(--ink); transition: color 0.35s, translate 0.6s var(--ease);
  }
  .idx { align-self: start; padding-top: 0.9em; font-size: 0.72rem; letter-spacing: 0.02em; color: var(--dim); min-width: 2.6rem; }
  /* Square accent pixel that grows in on hover and marks the current page */
  .pip { flex: none; width: 0.22em; height: 0.22em; background: var(--accent); scale: 0; transition: scale 0.45s var(--ease); }
  .menu-links a:hover .pip, .menu-links a:focus-visible .pip, .menu-links a[aria-current='page'] .pip { scale: 1; }
  .menu-links a:hover, .menu-links a:focus-visible { translate: 0.15em 0; }
  /* Dim the others while one is hovered */
  .menu-links ol:hover a:not(:hover) { color: var(--dim); }

  /* Letter roll: each letter flips to its copy, one after another */
  .word { display: inline-flex; }
  .ch { display: inline-block; height: 1em; overflow: hidden; }
  .ch > span { display: block; height: 1em; line-height: 1em; transition: transform 0.55s var(--ease); transition-delay: calc(var(--j) * 22ms); }
  .menu-links a:hover .ch > span, .menu-links a:focus-visible .ch > span { transform: translateY(-100%); }
  .ch > span:last-child { color: var(--accent-text); }

  @media (max-width: 760px) {
    .menu-body { grid-template-rows: 1fr auto; row-gap: 2rem; padding-top: calc(5.5rem + 1rem); }
    .menu-side { grid-column: 1 / -1; order: 2; }
    .menu-links { grid-column: 1 / -1; align-self: center; }
    .menu-info { grid-template-columns: 1fr 1fr; }
  }
</style>
