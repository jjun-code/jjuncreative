---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import { getSite } from '../lib/content';

interface Props { title?: string; description?: string; image?: string; footer?: boolean; footerCta?: boolean }
const site = await getSite();
const { title, description = site.description, image, footer = true, footerCta = true } = Astro.props;
const fullTitle = title ? `${title} — jjuncreative` : 'jjuncreative';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#141414" />
    <!-- Apply the saved or system theme before first paint, so there's no flash -->
    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
        // First page of the session shows the loader
        let seen = false;
        try { seen = sessionStorage.getItem('jj-loaded') === '1'; } catch {}
        if (!seen) document.documentElement.classList.add('is-loading');
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', t === 'light' ? '#f1f1ef' : '#141414');
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <!-- SVG favicon follows the browser's light/dark setting; PNGs cover Safari and home screens -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/OverusedGrotesk-VF.ttf" as="font" type="font/ttf" crossorigin />
    <!-- Pages swap without a full reload; the backdrop, cursor and trail carry over -->
    <ClientRouter />
  </head>
  <body>
    <Loader />
    <canvas class="backdrop" aria-hidden="true" transition:persist="backdrop"></canvas>
    <div class="site-grid" aria-hidden="true" transition:persist="site-grid"><i></i><i></i><i></i><i></i><i></i></div>
    <p class="coords mono" aria-hidden="true" transition:persist="coords"><span class="cx">0000</span> X&nbsp;&nbsp;<span class="cy">0000</span> Y</p>
    <Nav />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer site={site} cta={footerCta} />}
    <canvas class="trail" aria-hidden="true" transition:persist="trail"></canvas>
    <div class="cursor" aria-hidden="true" transition:persist="cursor"><span>view</span></div>
    <script>
      import { initSmooth } from '../scripts/smooth';
      import { initCursor } from '../scripts/cursor';
      import { initReveal } from '../scripts/reveal';
      import { initBackdrop } from '../scripts/backdrop';
      import { initCoords } from '../scripts/coords';
      import { initTrail } from '../scripts/trail';
      import { onPage } from '../scripts/page';
      // These live outside the swapped page content, so they start once
      initSmooth();
      initBackdrop();
      initCoords();
      initCursor();
      initTrail();
      onPage(initReveal);

      // The incoming page arrives without the theme the head script set on
      // first load; carry it over before it's shown, so there's no flash
      document.addEventListener('astro:before-swap', (e) => {
        const theme = document.documentElement.dataset.theme;
        if (theme) e.newDocument.documentElement.dataset.theme = theme;
        e.newDocument.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'light' ? '#f1f1ef' : '#141414');
      });
    </script>
  </body>
</html>
